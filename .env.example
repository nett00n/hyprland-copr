# Packager identity for RPM spec files
PACKAGER="Your Name <your.email@example.com>"
PACKAGER_NAME="Your Name"
PACKAGER_EMAIL="your.email@example.com"

# COPR repository (e.g., "nett00n/hyprland")
COPR_REPO=""

# Default Fedora version for builds (43, 44, or 45)
FEDORA_VERSION="43"

# Package to build (leave empty to build all)
PACKAGE=""

# Build control flags
SKIP_PACKAGES=""
PROCEED_BUILD=""
FORCE_MOCK=""
SYNCHRONOUS_COPR_BUILD=""

# #BUG-0039: how long `make copr-wait` retries polling Copr for a build
# submitted async (--nowait) to reach a terminal state, and how often, before
# `make readme` renders the nightly docs. A package still non-terminal at the
# deadline keeps `unknown` in tonight's docs and resolves on tomorrow's
# pre-submit poll instead.
COPR_POLL_TIMEOUT="1800"
COPR_POLL_INTERVAL="30"

# #BUG-0101: how many submodules/packages `make update-versions` pulls/
# resolves in parallel. 1 = strictly serial (the pre-#BUG-0101 behavior).
UPDATE_VERSIONS_JOBS="8"

# #COPR-0022: how many logs/runs/<run_id>/ directories to keep. Enforced after
# each full-cycle.py run starts, and by `make prune-logs KEEP=<n> CONFIRM=1`.
LOG_RETENTION_RUNS="10"
